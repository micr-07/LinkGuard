<?xml version="1.0" encoding="utf-8"?>
<!-- Material Design 3 的颜色角色，由各套配色方案的主题分别赋值。 -->
<resources>
    <attr name="lgPrimary" format="color" />
    <attr name="lgOnPrimary" format="color" />
    <attr name="lgPrimaryContainer" format="color" />
    <attr name="lgOnPrimaryContainer" format="color" />
    <attr name="lgSurface" format="color" />
    <attr name="lgSurfaceVariant" format="color" />
    <attr name="lgSurfaceContainer" format="color" />
    <attr name="lgSurfaceContainerHigh" format="color" />
    <!-- 状态层（点击水波纹）：on 色 + 低透明度，不能直接用实色 -->
    <attr name="lgRipple" format="color" />
    <attr name="lgOnSurface" format="color" />
    <attr name="lgOnSurfaceVariant" format="color" />
    <attr name="lgOutline" format="color" />
    <attr name="lgOutlineVariant" format="color" />
    <attr name="lgDanger" format="color" />
    <attr name="lgDangerContainer" format="color" />
    <attr name="lgPageBg" format="color" />
    <!-- RoundedBox：能把子视图（包括 WebView）裁成圆角的容器 -->
    <declare-styleable name="RoundedBox">
        <attr name="lgRadius" format="dimension" />
    </declare-styleable>
</resources>
