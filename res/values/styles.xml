        <item name="lgPageBg">#FFFDF7F2</item>
    </style>

    <!-- 玫红 -->
    <style name="Theme.LG.Pink" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF9C4059</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FFFFD9E1</item>
        <item name="lgOnPrimaryContainer">#FF3F0017</item>
