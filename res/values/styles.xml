    <style name="Theme.LG.Green" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF3B6939</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FFBCF0B4</item>
        <item name="lgOnPrimaryContainer">#FF002204</item>
        <item name="lgSurface">#FFFFFFFF</item>
        <item name="lgSurfaceVariant">#FFDEE5DA</item>
