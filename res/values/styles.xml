    <style name="Theme.LG.Orange" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF8B5000</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FFFFDCBE</item>
        <item name="lgOnPrimaryContainer">#FF2D1600</item>
        <item name="lgSurface">#FFFFFFFF</item>
        <item name="lgSurfaceVariant">#FFF0E0D2</item>
        <item name="lgOnSurface">#FF201A16</item>
        <item name="lgOnSurfaceVariant">#FF52443A</item>
        <item name="lgOutline">#FFA08D80</item>
        <item name="lgOutlineVariant">#FFEDE0D5</item>
        <item name="lgDanger">#FFBA1A1A</item>
