<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================
         基础主题
         ================================================================ -->

    <style name="Theme.LG.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">?attr/lgPageBg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">?attr/lgPageBg</item>
        <item name="android:navigationBarColor">?attr/lgSurface</item>
        <item name="android:colorAccent">?attr/lgPrimary</item>
        <item name="android:colorControlActivated">?attr/lgPrimary</item>
        <item name="android:textColorPrimary">?attr/lgOnSurface</item>
        <item name="android:textColorSecondary">?attr/lgOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/lgOutline</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Theme.LG.Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?attr/lgPageBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/lgPageBg</item>
        <item name="android:navigationBarColor">?attr/lgSurface</item>
        <item name="android:colorAccent">?attr/lgPrimary</item>
        <item name="android:textColorPrimary">?attr/lgOnSurface</item>
        <item name="android:textColorSecondary">?attr/lgOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/lgOutline</item>
    </style>

    <!-- ================================================================
         配色方案（每套主题只负责给颜色角色赋值）
         ================================================================ -->

    <!-- 默认蓝 -->
    <style name="Theme.LG.Blue" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF0B57D0</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FFD3E3FD</item>
        <item name="lgOnPrimaryContainer">#FF041E49</item>
        <item name="lgSurface">#FFFFFFFF</item>
        <item name="lgSurfaceVariant">#FFE3E2E8</item>
        <item name="lgOnSurface">#FF1A1C1E</item>
        <item name="lgOnSurfaceVariant">#FF44474F</item>
        <item name="lgOutline">#FF9AA0AA</item>
        <item name="lgOutlineVariant">#FFE0E5EC</item>
        <item name="lgDanger">#FFBA1A1A</item>
        <item name="lgDangerContainer">#FFFFDAD6</item>
        <item name="lgPageBg">#FFF6F8FC</item>
    </style>

    <!-- 紫（Material 3 基线） -->
    <style name="Theme.LG.Purple" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF6750A4</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FFEADDFF</item>
        <item name="lgOnPrimaryContainer">#FF21005D</item>
        <item name="lgSurface">#FFFFFFFF</item>
        <item name="lgSurfaceVariant">#FFE7E0EC</item>
        <item name="lgOnSurface">#FF1D1B20</item>
        <item name="lgOnSurfaceVariant">#FF49454F</item>
        <item name="lgOutline">#FF9C96A3</item>
        <item name="lgOutlineVariant">#FFE6E0EA</item>
        <item name="lgDanger">#FFB3261E</item>
        <item name="lgDangerContainer">#FFF9DEDC</item>
        <item name="lgPageBg">#FFF8F5FB</item>
    </style>

    <!-- 青 -->
    <style name="Theme.LG.Teal" parent="Theme.LG.Light">
        <item name="lgPrimary">#FF00696D</item>
        <item name="lgOnPrimary">#FFFFFFFF</item>
        <item name="lgPrimaryContainer">#FF9CF1F3</item>
        <item name="lgOnPrimaryContainer">#FF002021</item>
        <item name="lgSurface">#FFFFFFFF</item>
        <item name="lgSurfaceVariant">#FFDAE4E5</item>
        <item name="lgOnSurface">#FF191C1D</item>
        <item name="lgOnSurfaceVariant">#FF3F4849</item>
        <item name="lgOutline">#FF93A0A1</item>
        <item name="lgOutlineVariant">#FFDDE7E8</item>
        <item name="lgDanger">#FFBA1A1A</item>
        <item name="lgDangerContainer">#FFFFDAD6</item>
        <item name="lgPageBg">#FFF5FAFA</item>
