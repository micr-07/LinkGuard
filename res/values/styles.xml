    <!-- ================================================================
         MD3 排版
         ================================================================ -->

    <!-- M3 title large：22sp / 28sp / 0 / Regular -->
    <style name="Text.LG.Headline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- M3 title small：14sp / 20sp / 0.1sp / Medium（用分组标题） -->
    <style name="Text.LG.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 列表行：标题 body large 16sp -->
    <style name="Text.LG.RowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 列表行：副标题 body small 12sp -->
    <style name="Text.LG.RowSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- 列表行：尾部取值 body medium 14sp -->
    <style name="Text.LG.RowValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- M3 List 容器：CornerLarge 16dp -->
    <style name="Widget.LG.List" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/md_list</item>
    </style>

    <style name="Text.LG.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.LG.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.LG.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.LG.Sub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>

    <!-- ================================================================
         MD3 容器
         ================================================================ -->

    <style name="Widget.LG.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/md_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.LG.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">?attr/lgOutlineVariant</item>
    </style>

    <!-- ================================================================
         MD3 按钮
         ================================================================ -->

    <style name="Widget.LG.Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.LG.Button.Filled" parent="@style/Widget.LG.Button">
        <item name="android:background">@drawable/md_btn_filled</item>
        <item name="android:textColor">?attr/lgOnPrimary</item>
    </style>

    <style name="Widget.LG.Button.Tonal" parent="@style/Widget.LG.Button">
        <item name="android:background">@drawable/md_btn_tonal</item>
        <item name="android:textColor">?attr/lgOnPrimaryContainer</item>
    </style>

    <style name="Widget.LG.Button.Outlined" parent="@style/Widget.LG.Button">
        <item name="android:background">@drawable/md_btn_outlined</item>
        <item name="android:textColor">?attr/lgPrimary</item>
    </style>

    <style name="Widget.LG.Button.Outlined.Danger" parent="@style/Widget.LG.Button.Outlined">
        <item name="android:background">@drawable/md_btn_outlined_danger</item>
        <item name="android:textColor">?attr/lgDanger</item>
    </style>

    <!-- ================================================================
         MD3 输入框 / 列表行
         ================================================================ -->

    <style name="Widget.LG.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/md_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textColorHint">?attr/lgOnSurfaceVariant</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- ================================================================
         列表项
         ================================================================ -->

    <style name="Widget.LG.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- 状态卡：整屏唯一放按钮的地方 -->
    <style name="Widget.LG.StatusCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@drawable/md_card</item>
    </style>

    <!-- M3 Text button：次要动作，无容器，40dp -->
    <style name="Widget.LG.Button.Text" parent="@style/Widget.LG.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/lgPrimary</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- M3 headline small：对话框标题（22sp 是对中文的让步，规范为 24sp） -->
    <style name="Text.LG.DialogTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/lgOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- M3 对话框动作：文字按钮，40dp / 最小 64dp -->
    <style name="Widget.LG.Button.DialogAction" parent="@style/Widget.LG.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/lgPrimary</item>
    </style>

</resources>
