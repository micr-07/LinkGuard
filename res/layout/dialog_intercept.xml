<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/md_dialog_card"
        android:elevation="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Text.LG.Body"
                android:text="@string/ask_title" />

            <TextView
                android:id="@+id/tvRoot"
                style="@style/Text.LG.Headline"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvUrl"
                style="@style/Text.LG.Body"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:maxLines="3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSource"
                style="@style/Text.LG.Body"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDefault"
                style="@style/Text.LG.Body"
                android:layout_marginTop="10dp"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnOnce"
                    style="@style/Widget.LG.Button.Filled"
                    android:text="@string/opt_once" />

                <Button
                    android:id="@+id/btnAlways"
                    style="@style/Widget.LG.Button.Tonal"
                    android:layout_marginTop="10dp"
                    android:text="@string/opt_always" />

                <Button
                    android:id="@+id/btnBlock"
                    style="@style/Widget.LG.Button.Outlined.Danger"
                    android:layout_marginTop="10dp"
                    android:text="@string/opt_block" />

                <Button
                    android:id="@+id/btnAppBlock"
                    style="@style/Widget.LG.Button.Outlined.Danger"
                    android:layout_marginTop="10dp"
                    android:text="@string/block_this_app"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPickHint"
                    style="@style/Text.LG.Body"
                    android:text="@string/pick_hint_once" />

                <ScrollView
                    android:id="@+id/svBrowsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/llBrowsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <Button
                    android:id="@+id/btnBack"
                    style="@style/Widget.LG.Button.Outlined"
                    android:layout_marginTop="14dp"
                    android:text="@string/opt_back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
