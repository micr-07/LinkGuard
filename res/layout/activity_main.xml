<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面：一屏说清三件事 ——
    1. 现在有没有生效（顶部状态卡，只有这里放按钮）
    2. 网址规则在哪改（列表行，点进去）
    3. 行为与外观（列表行）
  列表行由 Rows.java 填充，行高/内边距遵循 M3 List（单行 56dp / 双行 72dp、左右 16dp）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/svMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lgPageBg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- 应用标识：Afacad Flux 渲染成的图片（tools/make_title.py 生成）
             PNG 是纯白+透明，用 tint 上主题色：浅色模式下是深蓝，深色模式下主题色本身
             就是浅蓝，看起来接近纯白，两个诉求一套机制。 -->
        <ImageView
            android:id="@+id/ivTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_linkguard"
            android:tint="?attr/lgPrimary" />

        <TextView
            style="@style/Text.LG.Body"
            android:layout_marginTop="4dp"
            android:id="@+id/tvSlogan" />

        <!-- ============ 状态卡：全屏唯一的操作区 ============ -->
        <LinearLayout
            android:id="@+id/cardStatus"
            style="@style/Widget.LG.StatusCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    style="@style/Text.LG.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusDesc"
                style="@style/Text.LG.Body"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnSetDefault"
                style="@style/Widget.LG.Button.Filled"
                android:layout_marginTop="16dp"
                android:text="@string/status_btn_set" />

            <Button
                android:id="@+id/btnAppSettings"
                style="@style/Widget.LG.Button.Text"
                android:layout_marginTop="2dp"
                android:text="@string/status_btn_settings"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ 拦截规则 ============ -->
        <TextView
            style="@style/Text.LG.Section"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:id="@+id/tvGroupRules" />

        <LinearLayout
            android:id="@+id/listRules"
            style="@style/Widget.LG.List" />

        <!-- ============ 行为 ============ -->
        <TextView
            style="@style/Text.LG.Section"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:id="@+id/tvGroupBehavior" />

        <LinearLayout
            android:id="@+id/listBehavior"
            style="@style/Widget.LG.List" />

        <!-- ============ 弹窗 ============ -->
        <TextView
            android:id="@+id/tvGroupDialog"
            style="@style/Text.LG.Section"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/listDialog"
            style="@style/Widget.LG.List" />

        <!-- ============ 外观 ============ -->
        <TextView
            style="@style/Text.LG.Section"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:id="@+id/tvGroupLook" />

        <LinearLayout
            android:id="@+id/listLook"
            style="@style/Widget.LG.List" />
    </LinearLayout>
</ScrollView>
